# =============================================================================
# TUZONAMARKET FRONTEND CONFIGURATION (.env.example)
# Arquitectura Distribuida: Frontend (React) + Backend (Odoo ERP) + Motor IA
# =============================================================================

# 1. SERVIDOR ODOO ERP
VITE_ODOO_TARGET=https://odoo.tuzonamarket.com
VITE_ODOO_API_URL=/api/odoo
VITE_ODOO_DB=odoo
VITE_ODOO_SESSION_ID=
VITE_ODOO_API_KEY=

# 2. SERVIDOR MOTOR DE RECOMENDACIONES (Microservicio Externo)
VITE_RECOMMENDATION_TARGET=http://localhost:8000
VITE_RECOMMENDATION_API_URL=

# 3. CONFIGURACIÓN LOCAL (VENEZUELA)
VITE_EXCHANGE_RATE_VES=46.50
VITE_DEFAULT_BRANCH_ID=b-val-norte
